// Prisma Schema for SkillSwap Platform
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum SkillType {
  TEACH
  LEARN
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SessionType {
  SKILL_SWAP
  MENTORING
  WORKSHOP
  PORTFOLIO_REVIEW
  INTERVIEW_PREP
  PROJECT_HELP
}

enum SessionStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum RoadmapStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PostCategory {
  CAREER
  PROGRAMMING
  DESIGN
  BUSINESS
  LANGUAGES
  CREATIVE
  GENERAL
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ReviewType {
  TEACHER
  LEARNER
}

enum FavoriteTargetType {
  USER
  SKILL
  ROADMAP
}

enum ReportReason {
  SPAM
  HARASSMENT
  FRAUD
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AIFeature {
  SKILL_PROFILER
  ROADMAP_GENERATOR
  MATCH_EXPLAINER
  LEARNING_COACH
  SESSION_PREP
  SESSION_SUMMARY
  PROFILE_IMPROVER
  RESOURCE_RECOMMENDER
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             Role              @default(USER)
  isVerified       Boolean           @default(false)
  isOnboarded      Boolean           @default(false)
  stripeCustomerId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  profile          Profile?
  skills           UserSkill[]
  learningGoals    LearningGoal[]
  roadmaps         LearningRoadmap[]
  sentConnections  Connection[]      @relation("SentConnections")
  receivedConnections Connection[]   @relation("ReceivedConnections")
  
  sentMessages     Message[]         @relation("SentMessages")
  conversations    Conversation[]    @relation("ConversationParticipants")
  
  hostSessions     Session[]         @relation("HostSessions")
  learnerSessions  Session[]         @relation("LearnerSessions")
  
  availabilities   Availability[]
  reviewsGiven     Review[]          @relation("ReviewsGiven")
  reviewsReceived  Review[]          @relation("ReviewsReceived")
  
  favorites        Favorite[]
  notifications    Notification[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  badges           UserBadge[]
  achievements     Achievement[]
  mentorOfferings  MentorOffering[]
  subscription     Subscription?
  reportsFiled     Report[]          @relation("ReporterUser")
  blockedUsers     BlockedUser[]     @relation("BlockerUser")
  blockedBy        BlockedUser[]     @relation("BlockedUser")
  aiInteractions   AIInteraction[]

  @@index([email])
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName         String
  username         String   @unique
  headline         String?
  bio              String?  @db.Text
  avatarUrl        String?
  location         String?
  timezone         String   @default("UTC")
  hourlyRate       Float?   @default(0) // 0 means free skill swap only
  isMentor         Boolean  @default(false)
  
  // Gamification & Reputation
  totalXp          Int      @default(0)
  level            Int      @default(1)
  reputationScore  Float    @default(5.0)
  rating           Float    @default(5.0)
  reviewCount      Int      @default(0)
  completedSessions Int     @default(0)
  responseRate     Float    @default(100.0) // Percentage
  reliabilityScore Float    @default(100.0) // Percentage
  learningStreak   Int      @default(0)
  
  // Onboarding parameters JSON
  preferredStyle   String?  // e.g. "Visual", "Hands-on", "Structured"
  availabilityNotes String?
  ninetyDayGoal    String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([username])
}

model SkillCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  // Lucide icon name
  skills      Skill[]
  createdAt   DateTime @default(now())

  @@index([slug])
}

model Skill {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  description    String?
  categoryId     String
  category       SkillCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  popularity     Int             @default(0)
  
  userSkills     UserSkill[]
  sessions       Session[]
  mentorOfferings MentorOffering[]
  
  createdAt      DateTime        @default(now())

  @@index([slug])
  @@index([categoryId])
}

model UserSkill {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  type            SkillType        // TEACH or LEARN
  proficiency     ProficiencyLevel @default(INTERMEDIATE)
  yearsExperience Float            @default(1.0)
  description     String?          @db.Text
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, skillId, type])
  @@index([userId])
  @@index([skillId])
}

model LearningGoal {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  targetSkill      String
  targetProficiency ProficiencyLevel @default(ADVANCED)
  targetDate       DateTime?
  isCompleted      Boolean          @default(false)
  progressPercent  Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
}

model LearningRoadmap {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  targetRole       String
  description      String?        @db.Text
  progressPercent  Int            @default(0)
  stages           RoadmapStage[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
}

model RoadmapStage {
  id             String             @id @default(uuid())
  roadmapId      String
  roadmap        LearningRoadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  orderIndex     Int
  title          String
  objective      String             @db.Text
  skillsJson     String             // JSON string of skill names
  estimatedHours Int                @default(10)
  resourcesJson  String             // JSON string of learning resources
  projectsJson   String             // JSON string of recommended projects
  status         RoadmapStageStatus @default(NOT_STARTED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([roadmapId])
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User             @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

model Conversation {
  id           String    @id @default(uuid())
  participants User[]    @relation("ConversationParticipants")
  messages     Message[]
  lastMessageAt DateTime @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Session {
  id             String        @id @default(uuid())
  hostId         String
  host           User          @relation("HostSessions", fields: [hostId], references: [id], onDelete: Cascade)
  learnerId      String
  learner        User          @relation("LearnerSessions", fields: [learnerId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  sessionType    SessionType   @default(SKILL_SWAP)
  status         SessionStatus @default(REQUESTED)
  
  startTime      DateTime
  endTime        DateTime
  durationMins   Int           @default(60)
  price          Float         @default(0)
  meetingUrl     String?
  notes          String?       @db.Text
  
  // AI Prep & Summary
  aiAgendaJson   String?       @db.Text
  aiSummaryJson  String?       @db.Text
  
  reviews        Review[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([hostId])
  @@index([learnerId])
  @@index([startTime])
}

model Availability {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   // e.g. "09:00"
  endTime   String   // e.g. "17:00"
  createdAt DateTime @default(now())

  @@index([userId])
}

model Review {
  id          String     @id @default(uuid())
  sessionId   String
  session     Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User       @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId  String
  reviewee    User       @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  
  rating      Int        // 1 to 5
  comment     String     @db.Text
  reviewType  ReviewType @default(TEACHER)
  createdAt   DateTime   @default(now())

  @@index([reviewerId])
  @@index([revieweeId])
  @@index([sessionId])
}

model Favorite {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FavoriteTargetType
  targetId   String
  createdAt  DateTime           @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "MATCH", "MESSAGE", "SESSION_REQUEST", "REVIEW"
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Post {
  id            String       @id @default(uuid())
  authorId      String
  author        User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  content       String       @db.Text
  category      PostCategory @default(GENERAL)
  likesCount    Int          @default(0)
  commentsCount Int          @default(0)
  comments      Comment[]
  likes         Like[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([authorId])
  @@index([category])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model Badge {
  id          String      @id @default(uuid())
  code        String      @unique // e.g. "FIRST_SWAP", "TOP_MENTOR"
  title       String
  description String
  icon        String      // Lucide icon or image path
  category    String      @default("GENERAL")
  userBadges  UserBadge[]
  createdAt   DateTime    @default(now())

  @@index([code])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  xpGranted   Int      @default(50)
  unlockedAt  DateTime @default(now())

  @@index([userId])
}

model MentorOffering {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title           String
  description     String   @db.Text
  price           Float
  durationMinutes Int      @default(60)
  sessionType     SessionType @default(MENTORING)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([skillId])
}

model Plan {
  id            String         @id @default(uuid())
  code          String         @unique // "FREE", "PRO", "MENTOR_PRO"
  name          String
  priceMonthly  Float
  featuresJson  String         // JSON array of feature strings
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String       // "PROFILE", "MESSAGE", "POST", "REVIEW"
  targetId   String
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([reporterId])
  @@index([status])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model AIInteraction {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature       AIFeature
  promptSummary String?
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([feature])
}
